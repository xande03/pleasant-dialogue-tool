# Chaves opcionais para refinamento de prompt via Google Gemini.
# A geração de imagem usa Pollinations (grátis, sem chave).
# Copie este arquivo para .env e preencha se quiser prompts refinados.
VITE_GEMINI_KEY=
VITE_GOOGLE_AI_KEY=
VITE_OPENROUTER_KEY=

# Chave da Groq usada pelo Chat IA.
# ⚠️ Variáveis VITE_* são embutidas no bundle do frontend e ficam visíveis
# a qualquer usuário que inspecione o site. Para esconder de verdade,
# use um edge function como proxy.
VITE_GROQ_API_KEY=
